            "type": "group",
            "children": [
              {
                "id": "style_type",
                "name": "style_type",
                "label": "Style",
                "type": "choice",
                "display": "select",
                "choices": [
                  ["solid", "Solid Color"],
                  ["gradient", "Gradient"]
                ],
                "default": "solid"
              },
              {
                "id": "solid_color",
                "name": "solid_color",
                "label": "Button Color",
                "type": "color",
                "default": { "color": "#E8434B", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "solid"
                }
              },
              {
                "id": "gradient_start",
                "name": "gradient_start",
                "label": "Gradient Start Color",
                "type": "color",
                "default": { "color": "#8B3FE8", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "gradient"
                }
              },
              {
                "id": "gradient_end",
                "name": "gradient_end",
                "label": "Gradient End Color",
                "type": "color",
                "default": { "color": "#C13FE8", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "gradient"
                }
              }
            ]
          },
          {
            "id": "content_gap",
