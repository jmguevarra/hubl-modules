[
  {
    "id": "heading",
    "name": "heading",
    "label": "Heading",
    "type": "text",
    "default": "AI-Powered Business"
  },
  {
    "id": "subheading",
    "name": "subheading",
    "label": "Subheading",
    "type": "text",
    "default": "We help you unlock compounding business value by embedding AI where it matters most."
  },
  {
    "id": "groups",
    "name": "groups",
    "label": "Card Groups",
    "help_text": "Add more than one group to split the cards into labelled rows (e.g. EXPLORE + DESIGN). Leave the group label blank if you only need a single row of cards.",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 6,
      "default": 1,
      "sorting_label_field": "group_label"
    },
    "children": [
      {
        "id": "group_label",
        "name": "group_label",
        "label": "Group Label (optional)",
        "type": "text",
        "default": ""
      },
      {
        "id": "cards",
        "name": "cards",
        "label": "Cards",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 6,
          "default": 3,
          "sorting_label_field": "card_title"
        },
        "children": [
          {
            "id": "card_icon",
            "name": "card_icon",
            "label": "Icon",
            "type": "image",
            "default": {
              "src": "",
              "alt": "",
              "width": 24,
              "height": 24
            }
          },
          {
            "id": "card_title",
            "name": "card_title",
            "label": "Title",
            "type": "text",
            "default": "Card title"
          },
          {
            "id": "card_description",
            "name": "card_description",
            "label": "Description",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  },
  {
    "id": "cta",
    "name": "cta",
    "label": "CTA Button",
    "type": "group",
    "children": [
      {
        "id": "cta_text",
        "name": "cta_text",
        "label": "Button Text",
        "type": "text",
        "default": "Book a call to learn more"
      },
      {
        "id": "cta_link",
        "name": "cta_link",
        "label": "Button Link",
        "type": "link",
        "default": {
          "url": { "type": "EXTERNAL", "href": "" },
          "open_in_new_tab": false,
          "no_follow": false
        }
      }
    ]
  },
  {
    "id": "styles",
    "name": "styles",
    "label": "Styles",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "id": "theme_color",
        "name": "theme_color",
        "label": "Theme Color",
        "help_text": "Controls the icon tint and the CTA button color for this box.",
        "type": "choice",
        "display": "select",
        "choices": [
          ["coral", "Coral"],
          ["blue", "Blue"],
          ["purple", "Purple"],
          ["custom", "Custom"]
        ],
        "default": "coral"
      },
      {
        "id": "custom_icon_bg_color",
        "name": "custom_icon_bg_color",
        "label": "Custom Icon Background",
        "type": "color",
        "default": { "color": "#E8434B", "opacity": 12 },
        "visibility": {
          "controlling_field_path": "styles.theme_color",
          "operator": "EQUAL",
          "controlling_value_regex": "custom"
        }
      },
      {
        "id": "custom_accent_color",
        "name": "custom_accent_color",
        "label": "Custom Button Color",
        "type": "color",
        "default": { "color": "#E8434B", "opacity": 100 },
        "visibility": {
          "controlling_field_path": "styles.theme_color",
          "operator": "EQUAL",
          "controlling_value_regex": "custom"
        }
      }
    ]
  }
]
