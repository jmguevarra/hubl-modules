                  "alt": "",
                  "width": 24,
                  "height": 24
                }
              },
              {
                "id": "card_title",
                "name": "card_title",
                "label": "Title",
                "type": "text",
                "default": "Card title"
              },
              {
                "id": "card_description",
                "name": "card_description",
                "label": "Description",
                "type": "text",
                "default": ""
              }
            ]
          }
        ]
      },
      {
        "id": "cta",
        "name": "cta",
        "label": "CTA Button",
        "type": "group",
        "children": [
