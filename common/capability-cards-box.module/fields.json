[
  {
    "id": "heading",
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "children": [
      {
        "id": "heading_text",
        "name": "heading_text",
        "label": "Heading Text",
        "type": "text",
        "default": "How we help you thrive in an AI-powered world"
      },
      {
        "id": "heading_tag",
        "name": "heading_tag",
        "label": "Heading Tag",
        "type": "choice",
        "display": "select",
        "choices": [
          ["h1", "H1"],
          ["h2", "H2"],
          ["h3", "H3"],
          ["h4", "H4"],
          ["h5", "H5"],
          ["h6", "H6"]
        ],
        "default": "h2"
      }
    ]
  },
  {
    "id": "content",
    "name": "content",
    "label": "Content",
    "type": "richtext",
    "default": "<p>When the environment is volatile, you need solid experience and trustworthy partners to lean on. Discover the ways PhoenixDX can help your business leverage AI — without the risk and chaos.</p>"
  },
  {
    "id": "boxes",
    "name": "boxes",
    "label": "Boxes",
    "help_text": "Each box renders as its own bordered card section (heading, rows of cards, and a CTA button).",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 6,
      "default": 1,
      "sorting_label_field": "box_heading"
    },
    "children": [
      {
        "id": "box_heading",
        "name": "box_heading",
        "label": "Heading",
        "type": "text",
        "default": "AI-Powered Business"
      },
      {
        "id": "box_heading_tag",
        "name": "box_heading_tag",
        "label": "Heading Tag",
        "type": "choice",
        "display": "select",
        "choices": [
          ["h1", "H1"],
          ["h2", "H2"],
          ["h3", "H3"],
          ["h4", "H4"],
          ["h5", "H5"],
          ["h6", "H6"]
        ],
        "default": "h3"
      },
      {
        "id": "box_subheading",
        "name": "box_subheading",
        "label": "Subheading",
        "type": "text",
        "default": "We help you unlock compounding business value by embedding AI where it matters most."
      },
      {
        "id": "rows",
        "name": "rows",
        "label": "Card Rows",
        "help_text": "Add more than one row to split the cards into labelled groups (e.g. EXPLORE + DESIGN). If a row's title is left blank, no label is displayed above it.",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 6,
          "default": 1,
          "sorting_label_field": "row_title"
        },
        "children": [
          {
            "id": "row_title",
            "name": "row_title",
            "label": "Row Title (optional)",
            "type": "text",
            "default": ""
          },
          {
            "id": "cards",
            "name": "cards",
            "label": "Cards",
            "type": "group",
            "occurrence": {
              "min": 1,
              "max": 6,
              "default": 3,
              "sorting_label_field": "card_title"
            },
            "children": [
              {
                "id": "card_icon",
                "name": "card_icon",
                "label": "Icon",
                "type": "image",
                "default": {
