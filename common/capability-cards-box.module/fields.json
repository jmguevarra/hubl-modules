[
  {
    "id": "boxes",
    "name": "boxes",
    "label": "Boxes",
    "help_text": "Each box renders as its own bordered card section (heading, rows of cards, and a CTA button).",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 6,
      "default": 1,
      "sorting_label_field": "box_heading"
    },
    "children": [
      {
        "id": "box_heading",
        "name": "box_heading",
        "label": "Heading",
        "type": "text",
        "default": "AI-Powered Business"
      },
      {
        "id": "box_subheading",
        "name": "box_subheading",
        "label": "Subheading",
        "type": "text",
        "default": "We help you unlock compounding business value by embedding AI where it matters most."
      },
      {
        "id": "rows",
        "name": "rows",
        "label": "Card Rows",
        "help_text": "Add more than one row to split the cards into labelled groups (e.g. EXPLORE + DESIGN). If a row's title is left blank, no label is displayed above it.",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 6,
          "default": 1,
          "sorting_label_field": "row_title"
        },
        "children": [
          {
            "id": "row_title",
            "name": "row_title",
            "label": "Row Title (optional)",
            "type": "text",
            "default": ""
          },
          {
            "id": "cards",
            "name": "cards",
            "label": "Cards",
            "type": "group",
            "occurrence": {
              "min": 1,
              "max": 6,
              "default": 3,
              "sorting_label_field": "card_title"
            },
            "children": [
              {
                "id": "card_icon",
                "name": "card_icon",
                "label": "Icon",
                "type": "image",
                "default": {
                  "src": "",
                  "alt": "",
                  "width": 24,
                  "height": 24
                }
              },
              {
                "id": "card_title",
                "name": "card_title",
                "label": "Title",
                "type": "text",
                "default": "Card title"
              },
              {
                "id": "card_description",
                "name": "card_description",
                "label": "Description",
                "type": "text",
                "default": ""
              }
            ]
          }
        ]
      },
      {
        "id": "cta",
        "name": "cta",
        "label": "CTA Button",
        "type": "group",
        "children": [
          {
            "id": "cta_text",
            "name": "cta_text",
            "label": "Button Text",
            "type": "text",
            "default": "Book a call to learn more"
          },
          {
            "id": "cta_link",
            "name": "cta_link",
            "label": "Button Link",
            "type": "link",
            "default": {
              "url": { "type": "EXTERNAL", "href": "" },
              "open_in_new_tab": false,
              "no_follow": false
            }
          }
        ]
      },
      {
        "id": "box_style",
        "name": "box_style",
        "label": "Box Style",
        "type": "group",
        "children": [
          {
            "id": "icon_bg_color",
            "name": "icon_bg_color",
            "label": "Icon Background Color",
            "type": "color",
            "default": { "color": "#E8434B", "opacity": 12 }
          },
          {
            "id": "button_style",
            "name": "button_style",
            "label": "Button Color",
            "type": "group",
            "children": [
              {
                "id": "style_type",
                "name": "style_type",
                "label": "Style",
                "type": "choice",
                "display": "select",
                "choices": [
                  ["solid", "Solid Color"],
                  ["gradient", "Gradient"]
                ],
                "default": "solid"
              },
              {
                "id": "solid_color",
                "name": "solid_color",
                "label": "Button Color",
                "type": "color",
                "default": { "color": "#E8434B", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "solid"
                }
              },
              {
                "id": "gradient_start",
                "name": "gradient_start",
                "label": "Gradient Start Color",
                "type": "color",
                "default": { "color": "#8B3FE8", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "gradient"
                }
              },
              {
                "id": "gradient_end",
                "name": "gradient_end",
                "label": "Gradient End Color",
                "type": "color",
                "default": { "color": "#C13FE8", "opacity": 100 },
                "visibility": {
                  "controlling_field_path": "boxes.box_style.button_style.style_type",
                  "operator": "EQUAL",
                  "controlling_value_regex": "gradient"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
