[
  {
    "id": "content",
    "name": "content",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "id": "heading",
        "name": "heading",
        "label": "Heading",
        "type": "group",
        "children": [
          {
            "id": "heading_text",
            "name": "heading_text",
            "label": "Heading Text",
            "type": "text",
            "default": "Claim your FREE AI Use Case Prioritisation Workshop"
          },
          {
            "id": "heading_tag",
            "name": "heading_tag",
            "label": "Heading Tag",
            "type": "choice",
            "display": "select",
            "choices": [
              ["h1", "H1"],
              ["h2", "H2"],
              ["h3", "H3"],
              ["h4", "H4"],
              ["h5", "H5"],
              ["h6", "H6"]
            ],
            "default": "h2"
          }
        ]
      },
      {
        "id": "description",
        "name": "description",
        "label": "Body",
        "type": "richtext",
        "default": "<p>We'll help you identify the right opportunities so you can move quickly, build with confidence, and start delivering real business value fast.</p>"
      }
    ]
  },
  {
    "id": "form",
    "name": "form",
    "label": "Form",
    "type": "group",
    "children": [
      {
        "id": "form_type",
        "name": "form_type",
        "label": "Form Type",
        "help_text": "HubSpot's module 'Form' picker only lists Legacy forms — that's a platform limitation, not a bug here. If your form was built in the current form editor, choose 'Current Form' and paste its Form ID instead.",
        "type": "choice",
        "display": "select",
        "choices": [
          ["current", "Current Form (new editor)"],
          ["legacy", "Legacy Form"]
        ],
        "default": "current"
      },
      {
        "id": "legacy_form",
        "name": "legacy_form",
        "display_width": null,
        "label": "Legacy Form",
        "required": false,
        "locked": false,
        "type": "form",
        "disable_inline_form_editing": true,
        "default": {
          "response_type": "inline",
          "message": "Thanks for submitting the form."
        },
        "visibility": {
          "controlling_field_path": "form.form_type",
          "operator": "EQUAL",
          "controlling_value_regex": "legacy"
        }
      },
      {
        "id": "current_form_id",
        "name": "current_form_id",
        "label": "Current Form ID",
        "help_text": "In the Forms tool, open the form → Share → Embed code, and copy the GUID after data-form-id (or from the form's edit URL). For this Form Card's colors to apply, the form's own Style tab must be set to NOT inherit HubSpot's default styling — otherwise HubSpot renders it inside an iframe your module CSS can't reach.",
        "type": "text",
        "default": "",
        "visibility": {
          "controlling_field_path": "form.form_type",
          "operator": "EQUAL",
          "controlling_value_regex": "current"
        }
      },
      {
        "id": "current_form_region",
        "name": "current_form_region",
        "label": "Form Region",
        "help_text": "Shown in the same embed code as the Form ID (data-region).",
        "type": "choice",
        "display": "select",
        "choices": [
          ["na1", "NA1"],
          ["eu1", "EU1"]
        ],
        "default": "na1",
        "visibility": {
          "controlling_field_path": "form.form_type",
          "operator": "EQUAL",
          "controlling_value_regex": "current"
        }
      }
    ]
  },
  {
    "id": "form_note",
    "name": "form_note",
    "label": "Form Note",
    "type": "richtext",
    "default": "<p>This form is only for who attended the DX Connect 2026 event.</p>"
  },
  {
    "id": "styles",
    "name": "styles",
    "label": "Styles",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "id": "section",
        "name": "section",
        "label": "Section",
        "type": "group",
        "children": [
          {
            "id": "spacing",
            "name": "spacing",
            "label": "Spacing",
            "type": "group",
            "children": [
              {
                "id": "desktop",
                "name": "desktop",
                "label": "Desktop",
                "type": "group",
                "children": [
                  {
                    "id": "desktop_padding_top",
                    "name": "desktop_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 80,
                    "min": 0
                  },
                  {
                    "id": "desktop_padding_bottom",
                    "name": "desktop_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 80,
                    "min": 0
                  }
                ]
              },
              {
                "id": "tablet",
                "name": "tablet",
                "label": "Tablet",
                "type": "group",
                "children": [
                  {
                    "id": "tablet_padding_top",
                    "name": "tablet_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 60,
                    "min": 0
                  },
                  {
                    "id": "tablet_padding_bottom",
                    "name": "tablet_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 60,
                    "min": 0
                  }
                ]
              },
              {
                "id": "mobile",
                "name": "mobile",
                "label": "Mobile",
                "type": "group",
                "children": [
                  {
                    "id": "mobile_padding_top",
                    "name": "mobile_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 40,
                    "min": 0
                  },
                  {
                    "id": "mobile_padding_bottom",
                    "name": "mobile_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 40,
                    "min": 0
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "content_style",
        "name": "content_style",
        "label": "Content Panel",
        "type": "group",
        "children": [
          {
            "id": "enable_styles",
            "name": "enable_styles",
            "label": "Enable Styles",
            "type": "boolean",
            "default": false
          },
          {
            "id": "heading_color",
            "name": "heading_color",
            "label": "Heading Color",
            "type": "color",
            "default": { "color": "#FFFFFF", "opacity": 100 },
            "visibility": {
              "controlling_field_path": "styles.content_style.enable_styles",
              "operator": "EQUAL",
              "controlling_value_regex": "true"
            }
          },
          {
            "id": "description_color",
            "name": "description_color",
            "label": "Body Text Color",
            "type": "color",
            "default": { "color": "#FFFFFF", "opacity": 80 },
            "visibility": {
              "controlling_field_path": "styles.content_style.enable_styles",
              "operator": "EQUAL",
              "controlling_value_regex": "true"
            }
          },
          {
            "id": "content_gap",
            "name": "content_gap",
            "label": "Gap",
            "help_text": "Space between the heading and body text.",
            "type": "group",
            "children": [
              {
                "id": "desktop_gap",
                "name": "desktop_gap",
                "label": "Desktop Gap (px)",
                "type": "number",
                "display": "text",
                "default": 20,
                "min": 0
              },
              {
                "id": "tablet_gap",
                "name": "tablet_gap",
                "label": "Tablet Gap (px)",
                "type": "number",
                "display": "text",
                "default": 16,
                "min": 0
              },
              {
                "id": "mobile_gap",
                "name": "mobile_gap",
                "label": "Mobile Gap (px)",
                "type": "number",
                "display": "text",
                "default": 14,
                "min": 0
              }
            ]
          },
          {
            "id": "content_justify",
            "name": "content_justify",
            "label": "Justify Content",
            "type": "choice",
            "display": "select",
            "choices": [
              ["flex-start", "Start"],
              ["center", "Center"],
              ["flex-end", "End"],
              ["space-between", "Space Between"]
            ],
            "default": "center"
          },
          {
            "id": "content_align",
            "name": "content_align",
            "label": "Align Items",
            "type": "choice",
            "display": "select",
            "choices": [
              ["flex-start", "Start"],
              ["center", "Center"],
              ["flex-end", "End"],
              ["stretch", "Stretch"]
            ],
            "default": "flex-start"
          }
        ]
      },
      {
        "id": "form_card_style",
        "name": "form_card_style",
        "label": "Form Card",
        "type": "group",
        "children": [
          {
            "id": "card_bg_color",
            "name": "card_bg_color",
            "label": "Card Background Color",
            "type": "color",
            "default": { "color": "#FFFFFF", "opacity": 100 }
          },
          {
            "id": "label_color",
            "name": "label_color",
            "label": "Label Color",
            "type": "color",
            "default": { "color": "#1C2340", "opacity": 100 }
          },
          {
            "id": "input_bg_color",
            "name": "input_bg_color",
            "label": "Input Background",
            "type": "color",
            "default": { "color": "#F2F2F2", "opacity": 100 }
          },
          {
            "id": "input_border_color",
            "name": "input_border_color",
            "label": "Input Border Color",
            "type": "color",
            "default": { "color": "#E0E0E0", "opacity": 100 }
          },
          {
            "id": "input_text_color",
            "name": "input_text_color",
            "label": "Input Text Color",
            "type": "color",
            "default": { "color": "#1C2340", "opacity": 100 }
          },
          {
            "id": "placeholder_color",
            "name": "placeholder_color",
            "label": "Placeholder Color",
            "type": "color",
            "default": { "color": "#9CA3AF", "opacity": 100 }
          },
          {
            "id": "button_style",
            "name": "button_style",
            "label": "Submit Button",
            "type": "group",
            "children": [
              {
                "id": "button_bg_color",
                "name": "button_bg_color",
                "label": "Background Color",
                "type": "color",
                "default": { "color": "#D81F26", "opacity": 100 }
              },
              {
                "id": "button_text_color",
                "name": "button_text_color",
                "label": "Text Color",
                "type": "color",
                "default": { "color": "#FFFFFF", "opacity": 100 }
              }
            ]
          },
          {
            "id": "form_note_color",
            "name": "form_note_color",
            "label": "Form Note Color",
            "type": "color",
            "default": { "color": "#D81F26", "opacity": 100 }
          }
        ]
      }
    ]
  }
]
