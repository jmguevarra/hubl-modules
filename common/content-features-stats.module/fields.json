[
  {
    "id": "heading",
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "children": [
      {
        "id": "heading_text",
        "name": "heading_text",
        "label": "Heading Text",
        "type": "text",
        "default": "Your trusted AI experts"
      },
      {
        "id": "heading_tag",
        "name": "heading_tag",
        "label": "Heading Tag",
        "type": "choice",
        "display": "select",
        "choices": [
          ["h1", "H1"],
          ["h2", "H2"],
          ["h3", "H3"],
          ["h4", "H4"],
          ["h5", "H5"],
          ["h6", "H6"]
        ],
        "default": "h2"
      }
    ]
  },
  {
    "id": "description",
    "name": "description",
    "label": "Description",
    "type": "richtext",
    "default": "<p>At PhoenixDX, we partner with organisations to help them transform, thrive and grow through the smart use of technology.</p>"
  },
  {
    "id": "button_section",
    "name": "button_section",
    "label": "Button",
    "type": "group",
    "children": [
      {
        "id": "button_text",
        "name": "button_text",
        "label": "Button Text",
        "type": "text",
        "default": "Let's Talk"
      },
      {
        "id": "button_type",
        "name": "button_type",
        "label": "Button Type",
        "type": "choice",
        "display": "select",
        "choices": [
          ["link", "Link"],
          ["anchor", "Anchor"]
        ],
        "default": "link"
      },
      {
        "id": "button_url",
        "name": "button_url",
        "label": "Button URL",
        "type": "url",
        "default": "",
        "visibility": {
          "controlling_field_path": "button_section.button_type",
          "operator": "EQUAL",
          "controlling_value_regex": "link"
        }
      },
      {
        "id": "button_new_tab",
        "name": "button_new_tab",
        "label": "Open in New Tab",
        "type": "boolean",
        "default": false,
        "visibility": {
          "controlling_field_path": "button_section.button_type",
          "operator": "EQUAL",
          "controlling_value_regex": "link"
        }
      },
      {
        "id": "button_anchor",
        "name": "button_anchor",
        "label": "Anchor ID",
        "type": "text",
        "default": "",
        "help_text": "Enter the section anchor ID to scroll to, e.g. #form-section",
        "visibility": {
          "controlling_field_path": "button_section.button_type",
          "operator": "EQUAL",
          "controlling_value_regex": "anchor"
        }
      }
    ]
  },
  {
    "id": "layout",
    "name": "layout",
    "label": "Layout",
    "help_text": "Order of the content and feature list columns",
    "type": "choice",
    "display": "select",
    "choices": [
      ["content-features", "Content | Features"],
      ["features-content", "Features | Content"]
    ],
    "default": "content-features"
  },
  {
    "id": "features",
    "name": "features",
    "label": "Features",
    "help_text": "Right-hand list of value props, separated by a divider line.",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 10,
      "default": 6,
      "sorting_label_field": "feature_title"
    },
    "children": [
      {
        "id": "feature_title",
        "name": "feature_title",
        "label": "Title",
        "type": "text",
        "default": "Proven AI expertise"
      },
      {
        "id": "feature_description",
        "name": "feature_description",
        "label": "Description",
        "type": "text",
        "default": ""
      }
    ]
  },
  {
    "id": "stats",
    "name": "stats",
    "label": "Stats",
    "help_text": "Full-width row of stat tiles below the content/features. Each number counts up from 0 when the row scrolls into view.",
    "type": "group",
    "occurrence": {
      "min": 0,
      "max": 6,
      "default": 6,
      "sorting_label_field": "stat_label"
    },
    "children": [
      {
        "id": "stat_value",
        "name": "stat_value",
        "label": "Number",
        "help_text": "The final value the counter animates to.",
        "type": "number",
        "default": 150
      },
      {
        "id": "stat_suffix",
        "name": "stat_suffix",
        "label": "Suffix",
        "help_text": "Shown after the number, e.g. '+', ' MVPs', '-Star'. Not included in the count animation.",
        "type": "text",
        "default": "+"
      },
      {
        "id": "stat_label",
        "name": "stat_label",
        "label": "Label",
        "type": "text",
        "default": "Successfully delivered projects"
      }
    ],
    "default": [
      { "stat_value": 150, "stat_suffix": "+", "stat_label": "Successfully delivered projects" },
      { "stat_value": 140, "stat_suffix": "+", "stat_label": "IT Professionals" },
      { "stat_value": 50, "stat_suffix": "+", "stat_label": "Customers" },
      { "stat_value": 210, "stat_suffix": "+", "stat_label": "Certifications" },
      { "stat_value": 6, "stat_suffix": " MVPs", "stat_label": "Worldwide Recognised Experts" },
      { "stat_value": 5, "stat_suffix": "-Star", "stat_label": "Customer Satisfaction Rating" }
    ]
  },
  {
    "id": "count_duration",
    "name": "count_duration",
    "label": "Counter Animation Duration (ms)",
    "type": "number",
    "default": 2000
  },
  {
    "id": "styles",
    "name": "styles",
    "label": "Styles",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "id": "section",
        "name": "section",
        "label": "Section",
        "type": "group",
        "children": [
          {
            "id": "spacing",
            "name": "spacing",
            "label": "Spacing",
            "type": "group",
            "children": [
              {
                "id": "desktop",
                "name": "desktop",
                "label": "Desktop",
                "type": "group",
                "children": [
                  {
                    "id": "desktop_padding_top",
                    "name": "desktop_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 80,
                    "min": 0
                  },
                  {
                    "id": "desktop_padding_bottom",
                    "name": "desktop_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 80,
                    "min": 0
                  }
                ]
              },
              {
                "id": "tablet",
                "name": "tablet",
                "label": "Tablet",
                "type": "group",
                "children": [
                  {
                    "id": "tablet_padding_top",
                    "name": "tablet_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 60,
                    "min": 0
                  },
                  {
                    "id": "tablet_padding_bottom",
                    "name": "tablet_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 60,
                    "min": 0
                  }
                ]
              },
              {
                "id": "mobile",
                "name": "mobile",
                "label": "Mobile",
                "type": "group",
                "children": [
                  {
                    "id": "mobile_padding_top",
                    "name": "mobile_padding_top",
                    "label": "Padding Top (px)",
                    "type": "number",
                    "display": "text",
                    "default": 40,
                    "min": 0
                  },
                  {
                    "id": "mobile_padding_bottom",
                    "name": "mobile_padding_bottom",
                    "label": "Padding Bottom (px)",
                    "type": "number",
                    "display": "text",
                    "default": 40,
                    "min": 0
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "button_style",
        "name": "button_style",
        "label": "Button Style",
        "type": "choice",
        "display": "select",
        "choices": [
          ["primary", "Primary"],
          ["primary-linear", "Primary Linear"],
          ["secondary", "Secondary"],
          ["blog", "Blog"],
          ["training", "Training"],
          ["blog-hover-fill", "Blog Hover-Fill"],
          ["training-hover-fill", "Training Hover-Fill"],
          ["primary-outline", "Primary Outline"],
          ["secondary-outline", "Secondary Outline"],
          ["tertiary-outline", "Tertiary Outline"]
        ],
        "default": "primary"
      },
      {
        "id": "content_style",
        "name": "content_style",
        "label": "Content Column",
        "type": "group",
        "children": [
          {
            "id": "content_gap",
            "name": "content_gap",
            "label": "Gap",
            "help_text": "Space between the heading, description, and CTA button.",
            "type": "group",
            "children": [
              {
                "id": "desktop_gap",
                "name": "desktop_gap",
                "label": "Desktop Gap (px)",
                "type": "number",
                "display": "text",
                "default": 16,
                "min": 0
              },
              {
                "id": "tablet_gap",
                "name": "tablet_gap",
                "label": "Tablet Gap (px)",
                "type": "number",
                "display": "text",
                "default": 14,
                "min": 0
              },
              {
                "id": "mobile_gap",
                "name": "mobile_gap",
                "label": "Mobile Gap (px)",
                "type": "number",
                "display": "text",
                "default": 12,
                "min": 0
              }
            ]
          },
          {
            "id": "content_justify",
            "name": "content_justify",
            "label": "Justify Content",
            "type": "choice",
            "display": "select",
            "choices": [
              ["flex-start", "Start"],
              ["center", "Center"],
              ["flex-end", "End"],
              ["space-between", "Space Between"]
            ],
            "default": "flex-start"
          },
          {
            "id": "content_align",
            "name": "content_align",
            "label": "Align Items",
            "type": "choice",
            "display": "select",
            "choices": [
              ["flex-start", "Start"],
              ["center", "Center"],
              ["flex-end", "End"],
              ["stretch", "Stretch"]
            ],
            "default": "flex-start"
          }
        ]
      },
      {
        "id": "stats_style",
        "name": "stats_style",
        "label": "Stats",
        "type": "group",
        "children": [
          {
            "id": "grid_columns",
            "name": "grid_columns",
            "label": "Desktop Columns",
            "type": "choice",
            "display": "select",
            "choices": [
              ["cols-2", "2 Columns"],
              ["cols-3", "3 Columns"]
            ],
            "default": "cols-3"
          },
          {
            "id": "bg_color",
            "name": "bg_color",
            "label": "Tile Background Color",
            "type": "color",
            "default": { "color": "#F1F2F4", "opacity": 100 }
          },
          {
            "id": "value_color",
            "name": "value_color",
            "label": "Value Color",
            "type": "color",
            "default": { "color": "#D81F26", "opacity": 100 }
          },
          {
            "id": "label_color",
            "name": "label_color",
            "label": "Label Color",
            "type": "color",
            "default": { "color": "#051327", "opacity": 100 }
          }
        ]
      }
    ]
  }
]
