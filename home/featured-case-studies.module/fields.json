[
  {
    "id": "heading",
    "name": "heading",
    "label": "Heading",
    "type": "text",
    "default": "Success, delivered"
  },
  {
    "id": "subheading",
    "name": "subheading",
    "label": "Subheading",
    "help_text": "Highlight individual words with the rich text color tool to match the brand-color accent style.",
    "type": "richtext",
    "default": "<p>Meeting complex <span style=\"color:#FFB43B\">challenges</span> and <span style=\"color:#24D7E0\">turning</span> software into business value, every time.</p>"
  },
  {
    "id": "case_studies",
    "name": "case_studies",
    "label": "Case Studies",
    "help_text": "Pick the featured image and the blog post / case study page each slide should link to.",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 8,
      "default": 4,
      "sorting_label_field": "case_image"
    },
    "children": [
      {
        "id": "case_image",
        "name": "case_image",
        "label": "Featured Image",
        "type": "image",
        "default": {
          "src": "",
          "alt": "",
          "width": 800,
          "height": 450
        }
      },
      {
        "id": "case_link",
        "name": "case_link",
        "label": "Blog Post / Case Study Link",
        "type": "link",
        "default": {
          "url": { "type": "EXTERNAL", "href": "#" },
          "open_in_new_tab": false,
          "no_follow": false
        }
      }
    ]
  },
  {
    "id": "slider_settings",
    "name": "slider_settings",
    "label": "Slider Settings",
    "type": "group",
    "children": [
      {
        "id": "enable_autoplay",
        "name": "enable_autoplay",
        "label": "Enable Autoplay",
        "type": "boolean",
        "default": false
      },
      {
        "id": "autoplay_speed",
        "name": "autoplay_speed",
        "label": "Autoplay Speed (ms)",
        "help_text": "Time in milliseconds before advancing to the next slide (e.g. 4000 = 4 seconds)",
        "type": "number",
        "default": 4000,
        "min": 1000,
        "max": 10000,
        "step": 500,
        "visibility": {
          "controlling_field_path": "slider_settings.enable_autoplay",
          "operator": "EQUAL",
          "controlling_value_regex": "true"
        }
      },
      {
        "id": "show_arrows",
        "name": "show_arrows",
        "label": "Show Navigation Arrows",
        "type": "boolean",
        "default": true
      },
      {
        "id": "loop",
        "name": "loop",
        "label": "Infinite Loop",
        "help_text": "When enabled, the slider wraps around — next after the last slide returns to the first, and vice versa",
        "type": "boolean",
        "default": true
      }
    ]
  },
  {
    "id": "award_logos",
    "name": "award_logos",
    "label": "Awards",
    "type": "group",
    "children": [
      {
        "id": "section_label",
        "name": "section_label",
        "label": "Section Label",
        "type": "text",
        "default": ""
      },
      {
        "id": "logos",
        "name": "logos",
        "label": "Award Logos",
        "help_text": "Displayed in an infinite scrolling marquee, same behavior as the homepage hero's trusted-by logos.",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 30,
          "default": 8,
          "sorting_label_field": "logo_alt"
        },
        "children": [
          {
            "id": "logo_image",
            "name": "logo_image",
            "label": "Logo",
            "type": "image",
            "default": {
              "src": "",
              "alt": "Award logo",
              "width": 130,
              "height": 60
            }
          }
        ]
      }
    ]
  },
  {
    "id": "footer_cta",
    "name": "footer_cta",
    "label": "CTA Link (top right of slider)",
    "type": "group",
    "children": [
      {
        "id": "button_text",
        "name": "button_text",
        "label": "Button Text",
        "type": "text",
        "default": "Explore more case studies"
      },
      {
        "id": "button_link",
        "name": "button_link",
        "label": "Button Link",
        "type": "link",
        "default": {
          "url": { "type": "EXTERNAL", "href": "#" },
          "open_in_new_tab": false,
          "no_follow": false
        }
      },
      {
        "id": "style",
        "name": "style",
        "label": "Style",
        "type": "group",
        "children": [
          {
            "id": "display_type",
            "name": "display_type",
            "label": "Display As",
            "type": "choice",
            "display": "select",
            "choices": [
              ["text", "Text Link"],
              ["button", "Button"]
            ],
            "default": "text"
          },
          {
            "id": "text_color",
            "name": "text_color",
            "label": "Text Color",
            "type": "color",
            "default": {
              "color": "#3F4F67",
              "opacity": 100
            },
            "visibility": {
              "controlling_field_path": "footer_cta.style.display_type",
              "operator": "EQUAL",
              "controlling_value_regex": "text"
            }
          },
          {
            "id": "arrow_color",
            "name": "arrow_color",
            "label": "Arrow Color",
            "type": "color",
            "default": {
              "color": "#D81F26",
              "opacity": 100
            },
            "visibility": {
              "controlling_field_path": "footer_cta.style.display_type",
              "operator": "EQUAL",
              "controlling_value_regex": "text"
            }
          },
          {
            "id": "button_style",
            "name": "button_style",
            "label": "Button Style",
            "type": "choice",
            "display": "select",
            "choices": [
              ["primary", "Primary"],
              ["primary-linear", "Primary Linear"],
              ["secondary", "Secondary"],
              ["blog", "Blog"],
              ["training", "Training"],
              ["blog-hover-fill", "Blog Hover-Fill"],
              ["training-hover-fill", "Training Hover-Fill"],
              ["primary-outline", "Primary Outline"],
              ["secondary-outline", "Secondary Outline"],
              ["tertiary-outline", "Tertiary Outline"]
            ],
            "default": "primary-outline",
            "visibility": {
              "controlling_field_path": "footer_cta.style.display_type",
              "operator": "EQUAL",
              "controlling_value_regex": "button"
            }
          }
        ]
      }
    ]
  },
  {
    "id": "styles",
    "name": "styles",
    "label": "Styles",
    "type": "group",
    "tab": "STYLE",
    "children": [
